# ── Convex ──────────────────────────────────────────────────────────────────
# Shared with apps/web — same Convex deployment (D-12: modest-magpie-797).
NEXT_PUBLIC_CONVEX_URL=https://modest-magpie-797.convex.cloud

# ── Clerk (dispatch-control ONLY) ────────────────────────────────────────────
# SECURITY NOTE (Pitfall 6): These keys must NEVER appear in apps/web or its
# Vercel project. dispatch-control must have its own Vercel project with its
# own environment variable set to prevent CLERK_SECRET_KEY from leaking into
# the public-facing site build.
#
# ⚠️  Create a SEPARATE Vercel project for dispatch-control so these keys are
#     never shared with the apps/web Vercel project.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ⚠️  CLERK_SECRET_KEY is a server-side secret. Never commit the real value.
# Never add this to apps/web. Never expose in client bundles.
CLERK_SECRET_KEY=sk_test_...

# Clerk routing (required — without this, auth.protect() has no redirect target)
# Pitfall 7: If NEXT_PUBLIC_CLERK_SIGN_IN_URL is unset, auth.protect() will
# redirect to `undefined` instead of the sign-in page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# ── Pipeline (FastAPI on Railway) ────────────────────────────────────────────
# Base URL of the pipeline service. REQUIRED — the review/control clients
# (test-run, scoring, run-control, review) throw at call time when this is
# unset; it is not optional despite older docs saying so.
NEXT_PUBLIC_PIPELINE_URL=https://your-pipeline.up.railway.app

# ── Review-gate preview (Phase 26) ───────────────────────────────────────────
# Signs the HMAC token used to build a signed preview URL for a run's issue
# before it is published (lib/previewToken.ts). Without both vars below, the
# review-gate preview silently degrades to "not configured" — no error, no
# preview. Generate locally: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
# Server-side secret — never expose to the client bundle.
PREVIEW_SECRET=CHANGE-ME-RANDOM-32-BYTES

# Base URL the review preview iframe points at (the public apps/web site),
# e.g. https://your-web-app.vercel.app. Paired with PREVIEW_SECRET.
NEXT_PUBLIC_WEB_PREVIEW_BASE=https://your-web-app.vercel.app
