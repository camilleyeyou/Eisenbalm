# ── Convex ──────────────────────────────────────────────────────────────────
# Shared with apps/web — same Convex deployment (D-12: modest-magpie-797).
NEXT_PUBLIC_CONVEX_URL=https://modest-magpie-797.convex.cloud

# ── Clerk (dispatch-control ONLY) ────────────────────────────────────────────
# SECURITY NOTE (Pitfall 6): These keys must NEVER appear in apps/web or its
# Vercel project. dispatch-control must have its own Vercel project with its
# own environment variable set to prevent CLERK_SECRET_KEY from leaking into
# the public-facing site build.
#
# ⚠️  Create a SEPARATE Vercel project for dispatch-control so these keys are
#     never shared with the apps/web Vercel project.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ⚠️  CLERK_SECRET_KEY is a server-side secret. Never commit the real value.
# Never add this to apps/web. Never expose in client bundles.
CLERK_SECRET_KEY=sk_test_...

# Clerk routing (required — without this, auth.protect() has no redirect target)
# Pitfall 7: If NEXT_PUBLIC_CLERK_SIGN_IN_URL is unset, auth.protect() will
# redirect to `undefined` instead of the sign-in page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
