{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": ["sanity.config.ts", "sanity.cli.ts", "schemas/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", ".sanity"]
}
