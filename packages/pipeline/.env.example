# ─────────────────────────────────────────────────────────────────────────────
# Eisenbalm Pipeline — Environment Variables (Phase 4)
# Copy to packages/pipeline/.env for local dev (gitignored).
# Provision in Railway via `railway variables set KEY=VALUE` (CONTEXT D-29).
# ─────────────────────────────────────────────────────────────────────────────

# ─── LangGraph Checkpointer (Railway Postgres) ───────────────────────────────
# NOTE: The var name SUPABASE_POSTGRES_URL is a legacy misnomer. This Postgres
# database moved from a (since-deleted) Supabase project to a Railway Postgres
# plugin on 2026-06-12 (see memory `pipeline-checkpointer-db`). Renaming the
# var is a wider change deferred to a future phase — for now, point it at the
# Railway Postgres instance's connection string.
#
# CRITICAL: AsyncPostgresSaver uses prepared statements via psycopg, so the
# connection string must be a direct/session-style connection that supports
# prepared statements — NOT a transaction-mode pooler (e.g. PgBouncer in
# transaction pooling mode), which raises
# psycopg.errors.InvalidSqlStatementName on the second checkpoint read.
#
# Get the value from Railway: project → Postgres plugin → "Connect" tab →
# copy the `DATABASE_URL` (or `DATABASE_PUBLIC_URL` if connecting from outside
# Railway's private network), then set it here as SUPABASE_POSTGRES_URL.
#
# Reference: 04-RESEARCH.md §7 + Pitfall 1 + Pitfall 2 (Supabase-era rationale;
# the IPv4/prepared-statement constraints still apply, now against Railway).
SUPABASE_POSTGRES_URL=postgres://USER:PASSWORD@HOST.railway.internal:5432/railway?sslmode=require

# ─── Convex (re-used from Phase 3) ───────────────────────────────────────────
# Pipeline calls Convex via HTTP at /api/mutation. Same key as apps/web.
# Reference: 04-RESEARCH.md §6
NEXT_PUBLIC_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud
CONVEX_DEPLOY_KEY=prod:YOUR-DEPLOY-KEY

# ─── Sanity (re-used from Phase 1, plus write token) ─────────────────────────
# Pipeline writes drafts via raw httpx (no maintained Python SDK — research §5).
NEXT_PUBLIC_SANITY_PROJECT_ID=YOUR-PROJECT-ID
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=skYOUR-WRITE-TOKEN

# Shared-secret header on /run/weekly and /run/{runId}/resume (CONTEXT D-31).
# Generate locally: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
PIPELINE_TRIGGER_SECRET=CHANGE-ME-RANDOM-32-BYTES

# ─── Phase 29 — Convex auth lockdown (D-1) ────────────────────────────────────
# Shared secret the pipeline sends on every guarded Convex mutation
# (packages/pipeline/.../lib/convex_client.py::convex_mutation injects this
# centrally). Validated Convex-side with a constant-time compare against the
# deployment's own PIPELINE_CONVEX_SECRET env var. Set the SAME value on
# Convex via `npx convex env set PIPELINE_CONVEX_SECRET <value>`.
# Generate locally: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
PIPELINE_CONVEX_SECRET=CHANGE-ME-RANDOM-32-BYTES

# Base URL the `trigger-weekly` CLI subcommand POSTs to (its /run/weekly).
# Read ONLY by `python -m eisenbalm_pipeline.cli trigger-weekly` — i.e. the
# SEPARATE Railway weekly-cron service, not the always-on web API (V2-03).
# Defaults to the production Railway domain when unset. Point it at a staging
# URL to trigger a non-prod deploy.
PIPELINE_SELF_URL=https://eisenbalm-pipeline-production.up.railway.app

# ─── Phase 5 — Agent Quality ────────────────────────────────────────────────

# OpenRouter API key — required for all real-mode LLM calls (AGT-17).
# Source: https://openrouter.ai/keys
# Already present from Phase 4; documented here for completeness.
OPENROUTER_API_KEY=

# Tavily Search API key — required by Scout (D-09) + Researcher (AGT-03, AGT-07).
# Source: https://tavily.com/dashboard
# Reserved by Phase 4 D-31; first wired in Phase 5.
TAVILY_API_KEY=

# Per-run dollar cap for LLM cost (D-08 + AGT-18).
# CostRecorder.check_cap() raises CostCapExceeded at this value;
# emits deliberationEvents 'cost-warning' at PIPELINE_COST_WARN_PCT * this.
PIPELINE_COST_CAP_USD=10.0

# Soft-warning percentage of the cap (D-08).
# At total_usd >= cap * this, a single 'cost-warning' event is emitted.
PIPELINE_COST_WARN_PCT=0.7

# Stub-mode toggle (D-22).
# Phase 5 default flips to "false" (real OpenRouter + Tavily calls).
# Set to "true" to exercise the Phase 4 PIP-06 stub fixtures path
# (Phase 4 PIP-06 integration test still relies on this).
# The runtime default change is applied in Plan 05-14;
# for now `lib/openrouter_client.py` still treats absent as "true".
EISENBALM_STUB_MODE=false

# ─── Phase 21 — Clerk JWT Verification ───────────────────────────────────
#
# The Clerk Frontend API URL — used by require_clerk_jwt to derive the JWKS
# endpoint: {CLERK_JWT_ISSUER_DOMAIN}/.well-known/jwks.json
#
# Where to find it: Clerk Dashboard → API Keys → Frontend API URL
#   e.g. https://verb-noun-00.clerk.accounts.dev
#
# Set this on Railway alongside PIPELINE_TRIGGER_SECRET. Leaving it unset
# degrades to local-dev mode (skips JWT verification with a logged warning),
# mirroring PIPELINE_TRIGGER_SECRET's skip-with-warning behaviour.
# Required in any deployed environment where dashboard-control endpoints are used.
CLERK_JWT_ISSUER_DOMAIN=

# ─── dispatch-control CORS (browser cross-origin) ─────────────────────────
# Comma-separated list of browser origins allowed to call the pipeline from the
# dispatch-control dashboard (test-run, scoring, run-control, review). The
# dashboard is a Vercel app on a different origin, so its browser preflight must
# be allowed here. Defaults to http://localhost:3000 when unset. In Railway, set
# this to the dispatch-control Vercel domain(s).
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000

# ─── Phase 6 — PDF Generation + Webhook Chain ─────────────────────────────

# Sanity webhook signing secret (WHK-02).
# Generate in Sanity Studio → API → Webhooks → "Add webhook" → Secret.
# Same value must be set as SANITY_WEBHOOK_SECRET in Sanity's webhook config
# and in Railway env. Algorithm: HMAC-SHA256 over f"{timestamp_ms}.{body}",
# base64url-no-pad encoded. Header format: t={ts_ms},v1={base64url}.
# Reference: 06-RESEARCH.md Pattern 1 + Pitfall 1.
SANITY_WEBHOOK_SECRET=CHANGE-ME-32-BYTES-RANDOM

# Vercel deploy hook URL (WHK-05).
# Create in Vercel project → Settings → Git → Deploy Hooks → "Create Hook".
# Set hook name "Eisenbalm Publisher" and target the production branch.
# Pipeline POSTs to this URL with no body, no auth (URL is the credential).
# TODO(ops): per-environment URLs — staging Railway must NEVER point at
#   the production hook. Reference: 06-RESEARCH.md Pitfall 10.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/CHANGE-ME

# ─── Phase 29 — Operational toggles (D-13) ───────────────────────────────────

# MED-02 reversible suppression flag (read at module-import time in
# graph/builder.py). Operationally significant Railway toggle — current live
# posture is "true" (DesignAgent node is skipped; theme falls back to
# defaults). Flip in the Railway dashboard + restart the service to re-enable
# the DesignAgent node. Accepted truthy values: "1", "true", "yes".
DESIGNAGENT_SUPPRESSED=true

# Python `logging` root level (read by api/main.py's logging.basicConfig at
# startup). Defaults to "INFO" when unset. Set to "DEBUG" for verbose agent
# tracing, "WARNING" to quiet routine request logs.
LOG_LEVEL=INFO
